{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "泡泡 · Bloop —— 桌面「随时指导」桌宠 Electron 重写版（非商业）",
  "author": "Jasolicon",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron --no-sandbox .",
    "start:sandbox": "electron .",
    "probe": "electron --no-sandbox tools/probe.cjs",
    "test": "node --test",
    "stt:install": "node tools/install-stt.mjs",
    "migrate-config": "node tools/migrate-config.mjs",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win dir",
    "icon": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/make-icon.ps1",
    "release:manifest": "node tools/make-update-manifest.mjs"
  },
  "build": {
    "appId": "org.palai.desktop-pet",
    "productName": "随时指导桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "presets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node",
      "assets/actions/**/*"
    ],
    "win": {
      "icon": "assets/deepseek.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.3.2"
  }
}
